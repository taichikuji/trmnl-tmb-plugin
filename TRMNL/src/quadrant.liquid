<div class="layout layout--col layout--top gap--[6px] lg:gap--medium tmb-board tmb-board--quadrant">
  <div class="tmb-heading w--full flex flex--row flex--between flex--nowrap gap--small border--h-50 pb--2">
    <span class="title lg:title--large text--bold w--min-0" data-clamp="1">{{ words[0] }}</span>
    {% if data_available %}<span class="label label--small lg:label--base">{{ notice_count }} {% if notice_count == 1 %}{{ words[1] }}{% else %}{{ words[2] }}{% endif %}</span>{% endif %}
  </div>
  {% if data_available == false or notice_count == 0 %}
    <div class="tmb-state w--full text--center">
      <div class="tmb-state-symbol flex flex--row flex--center-x flex--center-y text--bold">{% if data_available %}✓{% else %}!{% endif %}</div>
      <span class="title lg:title--xlarge" data-clamp="2">{% if data_available %}{{ words[5] }}{% else %}{{ words[7] }}{% endif %}</span>
      <div class="description lg:description--large" data-clamp="3">{% if data_available %}{{ words[6] }}{% else %}{{ words[8] }}{% endif %}</div>
    </div>
  {% else %}
    {% assign cards_shown = 0 %}
    <div class="tmb-card-grid w--full h--min-0 grid grid--cols-1 gap--xsmall lg:gap--medium">
      {% for line_id in priority_affected_line_ids %}
        {% if line_id != blank %}
          {% if cards_shown >= 2 %}{% break %}{% endif %}
          {% assign cards_shown = cards_shown | plus: 1 %}
          {% render 'line_card', line_id: line_id, sorted_alerts: sorted_alerts, ordered_indices: ordered_indices, lines_data: lines_data, words: words %}
        {% endif %}
      {% endfor %}
    </div>
    {% if affected_count > cards_shown %}<span class="label label--small lg:label--base tmb-more mt--auto">+{{ affected_count | minus: cards_shown }} {{ words[16] }}</span>{% endif %}
  {% endif %}
</div>
<div class="title_bar">
  <img class="image image--adaptive" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" width="28" height="28" alt="TMB" />
  <span class="title">{{ trmnl.plugin_settings.instance_name | default: 'TMB Alerts' | escape }}</span>
  <span class="instance">TMB</span>
</div>
