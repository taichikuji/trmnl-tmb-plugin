<style>
  /* TMB-prefixed classes keep these styles local to the plugin. */
  .tmb-heading { align-items: baseline; }
  .tmb-heading .title { flex: 1; }
  .tmb-tab { padding-bottom: 3px; border-bottom: 3px solid currentColor; }
  .tmb-line-card { gap: 10px; min-height: 68px; padding: 10px 10px 10px 14px; border: 1px solid var(--gray-50); overflow: hidden; }
  .tmb-line-badge { flex-shrink: 0; line-height: 1; gap: 0; }
  .tmb-line-branch { font-size: 0.7em; }
  .tmb-line-route { display: block; margin-bottom: 5px; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tmb-card-grid + .tmb-source { width: calc(50% - 5px); }
  .tmb-status-dot { flex-shrink: 0; border: 1px solid var(--black); }
  .tmb-board--full .tmb-source, .tmb-board--quadrant .tmb-more { margin-top: auto; }
  .tmb-source .qr-code { display: block; box-sizing: content-box; width: 84px; height: 84px; padding: 11px; background: var(--white); }
  .tmb-state { margin: auto; }
  .tmb-state-symbol { margin: 0 auto 12px; border: 2px solid currentColor; border-radius: 50%; font-size: 30px; }
  .tmb-state .description { margin: 8px auto 0; max-width: 32em; }
  .tmb-board--compact .tmb-line-route { margin-bottom: 1px; }
  .tmb-board--compact .tmb-line-card { min-height: 42px; padding: 3px 7px 3px 11px; gap: 7px; }
  .screen--1bit .tmb-board--compact .tmb-line-card { border-color: var(--black); }
  .screen--lg .tmb-board .tmb-line-card { min-height: 96px; padding: 14px 16px 14px 22px; gap: 16px; }
  .screen--lg .tmb-board .tmb-source .qr-code { width: 144px; height: 144px; padding: 12px; }
  .screen:not(.screen--lg) .tmb-board--dense .tmb-card-grid { flex: 1; margin-bottom: 112px; grid-auto-rows: 1fr; gap: 3px 10px; }
  .screen:not(.screen--lg) .tmb-board--dense .tmb-line-route { margin-bottom: 0; }
  .screen:not(.screen--lg) .tmb-board--dense .tmb-line-card { min-height: 36px; padding: 2px 8px 2px 12px; }
  .screen--lg .tmb-board--dense-x .tmb-card-grid { flex: 1; margin-bottom: 128px; grid-auto-rows: 1fr; gap: 3px 10px; }
  .screen--lg .tmb-board--dense-x .tmb-line-card { min-height: 64px; padding: 8px 12px 8px 18px; }
  .screen--lg .tmb-board--dense-x .tmb-source .qr-code { width: 96px; height: 96px; padding: 8px; }
  .screen--lg .tmb-board--compact .tmb-line-card { min-height: 64px; padding: 7px 10px 7px 16px; gap: 10px; }
  :is(.screen--1bit, .screen--2bit, .screen--4bit):not([class*="screen--color-"]) .tmb-line-badge { color: var(--white) !important; -webkit-text-fill-color: var(--white) !important; background: var(--black) !important; }
  .screen:not([class*="screen--color-"]) :is(.tmb-tab, .tmb-alert-symbol) { color: var(--black) !important; -webkit-text-fill-color: var(--black) !important; }
  .screen:not([class*="screen--color-"]) .tmb-status-dot { background: var(--black) !important; }
  .screen--color-4bwry .tmb-alert-symbol { color: var(--red) !important; }
  .screen--color-4bwry .tmb-line-badge.bg--green { color: var(--black) !important; -webkit-text-fill-color: var(--black) !important; }
  .screen--lg .tmb-board .tmb-state-symbol { font-size: 44px; }
</style>

{% template line_card %}
  {% assign route = words[16] %}
  {% for line_string in lines_data %}
    {% assign line_parts = line_string | split: ';' %}
    {% if line_parts[0] == line_id %}{% assign route = line_parts[1] %}{% break %}{% endif %}
  {% endfor %}
  {% assign line_notice_count = 0 %}
  {% assign traffic_rank = 0 %}
  {% assign traffic_label = words[24] %}
  {% assign traffic_color = 'bg--yellow' %}
  {% assign infrastructure = false %}
  {% assign uncertain = false %}
  {% assign undated = false %}
  {% for index_string in ordered_indices %}
    {% assign alert_index = index_string | plus: 0 %}
    {% assign alert = alerts[alert_index] %}
    {% assign belongs_to_line = false %}
    {% for entity in alert.entities %}
      {% assign entity_line_id = entity.line_name | strip %}
      {% assign entity_line_code = entity.line_code | append: '' %}
      {% if entity_line_id == blank and entity_line_code == '99' %}{% assign entity_line_id = 'FM' %}{% endif %}
      {% if entity_line_id == line_id or entity_line_id == 'ALL' or entity_line_code == 'ALL' %}{% assign belongs_to_line = true %}{% break %}{% endif %}
    {% endfor %}
    {% unless belongs_to_line %}{% continue %}{% endunless %}
    {% assign line_notice_count = line_notice_count | plus: 1 %}
    {% assign token = index_string | prepend: ',' | append: ',' %}
    {% if undated_indices contains token %}{% assign undated = true %}{% endif %}
    {% assign effect_type = alert.categories.effect_type | default: alert.effect.type | upcase %}
    {% assign effect_code = alert.categories.effect_code | default: alert.effect.code | upcase %}
    {% assign status = alert.categories.effect_status | default: alert.effect.status | upcase %}
    {% if status == 'NO_DATA' or effect_code == 'PP99' %}{% assign uncertain = true %}{% endif %}
    {% case effect_type %}
      {% when 'TRAFFIC' %}
        {% assign rank = 1 %}{% assign label = words[24] %}
        {% case effect_code %}
          {% when 'PP1', 'NP3' %}{% assign rank = 2 %}{% assign label = words[21] %}
          {% when 'PP5', 'PP10' %}{% assign rank = 3 %}{% assign label = words[23] %}
          {% when 'NP1', 'NP2', 'NP9' %}{% assign rank = 3 %}{% assign label = words[26] %}
          {% when 'PP99' %}{% assign rank = 0 %}
        {% endcase %}
        {% if status == 'NO_DATA' %}{% assign rank = 0 %}{% endif %}
        {% if rank > traffic_rank %}{% assign traffic_rank = rank %}{% assign traffic_label = label %}{% endif %}
        {% if status == 'SEVERE' or status == 'CRITICAL' or rank == 3 %}{% assign traffic_color = 'bg--red' %}{% endif %}
      {% when 'INFRASTRUCTURE' %}{% assign infrastructure = true %}
      {% else %}{% assign uncertain = true %}
    {% endcase %}
  {% endfor %}
  {% assign line_color = 'bg--black' %}{% assign line_text = 'text--white' %}
  {% case line_id %}
    {% when 'L1' %}{% assign line_color = 'bg--red' %}
    {% when 'L2' %}{% assign line_color = 'bg--purple' %}
    {% when 'L3', 'L11' %}{% assign line_color = 'bg--green' %}
    {% when 'L4' %}{% assign line_color = 'bg--yellow' %}{% assign line_text = 'text--black' %}
    {% when 'L5' %}{% assign line_color = 'bg--blue' %}
    {% when 'L9N', 'L9S' %}{% assign line_color = 'bg--orange' %}
    {% when 'L10N', 'L10S' %}{% assign line_color = 'bg--cyan' %}{% assign line_text = 'text--black' %}
  {% endcase %}
  <div class="item tmb-line-card" data-line-id="{{ line_id | escape }}">
    <span class="tmb-line-rail absolute top--0 bottom--0 left--0 w--[5px] lg:w--[7px] {{ line_color }}"></span>
    <span class="label lg:label--large tmb-line-badge {% if compact %}w--[32px] h--[32px]{% elsif line_count > 7 %}w--[28px] h--[28px]{% else %}w--[38px] h--[38px]{% endif %} lg:w--[52px] lg:h--[52px] self--center flex flex--col flex--center-x flex--center-y text--bold {{ line_color }} {{ line_text }}">{% if line_id contains 'L9' or line_id contains 'L10' %}{{ line_id | remove: 'N' | remove: 'S' | escape }}<span class="tmb-line-branch">{{ line_id | slice: -1, 1 | escape }}</span>{% else %}{{ line_id | escape }}{% endif %}</span>
    <div class="content w--min-0">
      <span class="title title--small lg:title--base tmb-line-route" data-clamp="1">{{ route | escape }}</span>
      <div class="tmb-line-status flex flex--row flex--wrap flex--center-y {% if compact %}gap--[4px]{% else %}gap--[9px] lg:gap--xsmall{% endif %}">
        <span class="label label--small lg:label--base gap--[4px] tmb-circulation">{% if traffic_rank > 0 %}<span class="tmb-status-dot {{ traffic_color }} w--[10px] h--[10px] lg:w--[14px] lg:h--[14px] rounded--full" aria-hidden="true"></span>{{ traffic_label }}{% elsif undated %}{{ words[18] }}{% elsif uncertain %}{{ words[25] }}{% else %}<span class="tmb-status-dot bg--green w--[10px] h--[10px] lg:w--[14px] lg:h--[14px] rounded--full" aria-hidden="true"></span>{{ words[27] }}{% endif %}</span>
        {% if traffic_rank > 0 and undated %}<span class="label label--small lg:label--base gap--[4px]">{{ words[28] }}</span>{% endif %}
        {% if infrastructure %}<span class="label label--small lg:label--base gap--[4px]"><svg class="tmb-alert-symbol {% if compact or line_count <= 7 %}w--[15px] h--[15px]{% else %}w--[12px] h--[12px]{% endif %} lg:w--[20px] lg:h--[20px] text--orange" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 2 19 18H1Z"/><path d="M10 7v5m0 2v1"/></svg> {{ words[22] }}</span>{% endif %}
        <span class="label label--small lg:label--base gap--[4px]">{{ line_notice_count }} {% if line_notice_count == 1 %}{{ words[1] }}{% else %}{{ words[2] }}{% endif %}</span>
      </div>
    </div>
  </div>
{% endtemplate %}

{% assign user_lang = trmnl.plugin_settings.custom_fields_values.userLanguage | default: "english" | downcase %}
{% case user_lang %}
  {% when "spanish" %}
    {% assign words = "Líneas con incidencias|aviso|avisos|línea afectada|líneas afectadas|Sin avisos vigentes|TMB no comunica incidencias vigentes en los avisos consultados.|Datos no disponibles|No se ha podido leer la información de TMB.|Grave|Atención|Información|Desde|Hasta|más|Avisos de servicio|Red de metro|Próximas afectaciones|Fechas no disponibles|Más detalles en TMB|VIGENTE|Servicio parcial|Alteración|Servicio parado|Servicio alterado|Info no disponible|Línea parada|Servicio normal|Sin fecha" | split: "|" %}
  {% when "catalan" %}
    {% assign words = "Línies amb incidències|avís|avisos|línia afectada|línies afectades|Sense avisos vigents|TMB no comunica incidències vigents en els avisos consultats.|Dades no disponibles|No s’ha pogut llegir la informació de TMB.|Greu|Atenció|Informació|Des de|Fins a|més|Avisos de servei|Xarxa de metro|Properes afectacions|Dates no disponibles|Més detalls a TMB|VIGENT|Servei parcial|Alteració|Servei aturat|Servei alterat|Info no disponible|Línia aturada|Servei normal|Sense data" | split: "|" %}
  {% else %}
    {% assign words = "Lines with service notices|notice|notices|affected line|affected lines|No current service notices|TMB reports no current incidents in the notices checked.|Data unavailable|Could not read the service information from TMB.|Severe|Warning|Information|From|Until|more|Service notices|Metro network|Upcoming|Dates unavailable|More details on TMB|CURRENT|Partial service|Disruption|Service stopped|Service disruption|Info not available|Line stopped|Normal service|Undated" | split: "|" %}
{% endcase %}
{% assign data_available = false %}
{% assign alerts_json_start = data.alerts | json | slice: 0, 1 %}
{% if alerts_json_start == '[' %}{% assign data_available = true %}{% endif %}
{% assign alerts = '' | split: ',' %}
{% if data_available %}{% assign alerts = data.alerts %}{% endif %}
{% assign now_s = 'now' | date: '%s' | plus: 0 %}
{% assign urgent_indices = '' %}{% assign traffic_indices = '' %}{% assign severe_indices = '' %}{% assign other_indices = '' %}
{% assign undated_indices = ',' %}
{% assign notice_count = 0 %}{% assign upcoming_count = 0 %}{% assign undated_count = 0 %}
{% comment %}Disruption windows determine current service, not publication dates.{% endcomment %}
{% for alert in alerts %}
  {% assign dated = false %}{% assign active = false %}{% assign upcoming = false %}
  {% for window in alert.disruption_dates %}
    {% assign begin_s = window.begin_date | plus: 0 %}{% assign end_s = window.end_date | plus: 0 %}
    {% if begin_s > 9999999999 %}{% assign begin_s = begin_s | divided_by: 1000 %}{% endif %}
    {% if end_s > 9999999999 %}{% assign end_s = end_s | divided_by: 1000 %}{% endif %}
    {% if window.begin_date != nil and begin_s <= 0 %}{% continue %}{% endif %}
    {% if window.end_date != nil and end_s <= 0 %}{% continue %}{% endif %}
    {% if begin_s > 0 and end_s > 0 and begin_s > end_s %}{% continue %}{% endif %}
    {% if begin_s > 0 or end_s > 0 %}
      {% assign dated = true %}
      {% if begin_s > now_s %}{% assign upcoming = true %}
      {% elsif end_s <= 0 or end_s >= now_s %}{% assign active = true %}{% endif %}
    {% endif %}
  {% endfor %}
  {% if dated and active == false %}
    {% if upcoming %}{% assign upcoming_count = upcoming_count | plus: 1 %}{% endif %}
    {% continue %}
  {% endif %}
  {% if dated == false %}
    {% assign undated_indices = undated_indices | append: forloop.index0 | append: ',' %}
    {% assign undated_count = undated_count | plus: 1 %}
  {% endif %}
  {% assign notice_count = notice_count | plus: 1 %}
  {% assign effect_type = alert.categories.effect_type | default: alert.effect.type | upcase %}
  {% assign status = alert.categories.effect_status | default: alert.effect.status | upcase %}
  {% assign effect_code = alert.categories.effect_code | default: alert.effect.code | upcase %}
  {% assign stopped_codes = 'PP5|PP10|NP1|NP2|NP9' | split: '|' %}
  {% if effect_type == 'TRAFFIC' %}
    {% if status == 'SEVERE' or status == 'CRITICAL' or stopped_codes contains effect_code %}{% assign urgent_indices = urgent_indices | append: forloop.index0 | append: ',' %}
    {% else %}{% assign traffic_indices = traffic_indices | append: forloop.index0 | append: ',' %}{% endif %}
  {% elsif status == 'SEVERE' or status == 'CRITICAL' %}{% assign severe_indices = severe_indices | append: forloop.index0 | append: ',' %}
  {% else %}{% assign other_indices = other_indices | append: forloop.index0 | append: ',' %}{% endif %}
{% endfor %}
{% assign ordered_indices = urgent_indices | append: traffic_indices | append: severe_indices | append: other_indices | split: ',' %}
{% assign affected_ids = '|' %}{% assign affected_count = 0 %}{% assign network_alert = false %}
{% for index_string in ordered_indices %}
  {% assign alert_index = index_string | plus: 0 %}
  {% assign alert = alerts[alert_index] %}
  {% for entity in alert.entities %}
    {% assign line_id = entity.line_name | strip %}{% assign line_code = entity.line_code | append: '' %}
    {% if line_id == 'ALL' or line_code == 'ALL' %}{% assign network_alert = true %}{% continue %}{% endif %}
    {% if line_id == blank and line_code == '99' %}{% assign line_id = 'FM' %}{% endif %}
    {% assign token = line_id | prepend: '|' | append: '|' %}
    {% unless line_id == blank or line_id contains '|' or affected_ids contains token %}
      {% assign affected_ids = affected_ids | append: line_id | append: '|' %}
      {% assign affected_count = affected_count | plus: 1 %}
    {% endunless %}
  {% endfor %}
{% endfor %}
{% if network_alert %}{% assign affected_ids = 'L1|L2|L3|L4|L5|L9N|L9S|L10N|L10S|L11|FM' %}{% assign affected_count = 11 %}{% endif %}
{% assign affected_line_ids = affected_ids | split: '|' %}
{% assign lines_data = "L1;Hospital de Bellvitge / Fondo~L2;Paral·lel / Badalona Pompeu Fabra~L3;Zona Universitària / Trinitat Nova~L4;La Pau / Trinitat Nova~L5;Cornellà Centre / Vall d’Hebron~L9N;La Sagrera / Can Zam~L9S;Aeroport T1 / Zona Universitària~L10N;La Sagrera / Gorg~L10S;ZAL | Riu Vell / Collblanc~L11;Trinitat Nova / Can Cuiàs~FM;Paral·lel / Parc de Montjuïc" | split: '~' %}
{% assign source_url = 'https://www.tmb.cat/en/barcelona-transport/status-metro-network' %}
{% case user_lang %}{% when 'spanish' %}{% assign source_url = 'https://www.tmb.cat/es/transporte-barcelona/estado-red-metro' %}{% when 'catalan' %}{% assign source_url = 'https://www.tmb.cat/ca/transport-barcelona/estat-xarxa-metro' %}{% endcase %}
{%- capture svg_logo -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="-0.00071907 -0.0010941 93.88 70.99" width="256" height="256">
	<path d="M73 37.14H69.52l-.99 3.53h3.61c.53-.04 1.08-.06 1.65-.55.37-.28.67-.72.8-1.18.48-1.7-1.05-1.78-1.58-1.8Zm1.78-6.9H71.46l-.87 3.09h3.2c.54 0 1.88 0 2.31-1.52.41-1.5-.81-1.56-1.32-1.58ZM61.71 44.58 66.8 26.39H77.57c1.12.05 3.21.13 4.2 1.47.61.77.69 1.98.36 3.14-.38 1.34-1.26 2.47-2.18 3.19-.63.49-1.15.7-1.82.98.69.21 1.31.39 1.83 1.11.75 1 .59 2.19.34 3.09-.37 1.37-1.18 2.78-2.37 3.71-1.75 1.39-3.65 1.45-5.08 1.5H61.72Zm-25.24-0 5.09-18.19h8.22l-.11 8.4c-.1 1.8-.14 2.21-.34 3.86.96-2.24 1.2-2.7 2.1-4.46l4.24-7.8h8.22L58.8 44.58H53.33l2.94-10.51c.41-1.34.52-1.68 1.06-3.22-.7 1.36-.82 1.62-1.55 2.94L49.74 44.58H45.47l.05-10.23c.02-1.47 0-1.5.1-3.4-.23 1.14-.29 1.42-.58 2.45L41.91 44.58H36.45ZM24.68 26.36H39.64l-1.26 4.51H33.77L29.93 44.58H24.19l3.84-13.71H23.41ZM.58 48.95S.24 22.8 33.93 12.63c0 0-26.27 11.87-26.27 33.8 0 11.54 7.77 24.56 31.98 24.56S87.72 51.8 92.4 36.38C97.09 20.96 90.3 9.44 76.19 3.37 60.77-3.25 35.99.18 20.23 11.03-5.28 28.59.58 48.95.58 48.95" fill="#000000"/>
</svg>
{%- endcapture -%}
{%- capture affected_summary -%}
  {%- if data_available -%}
    {{- affected_count }} {% if affected_count == 1 %}{{ words[3] }}{% else %}{{ words[4] }}{% endif -%}
  {%- endif -%}
{%- endcapture -%}
