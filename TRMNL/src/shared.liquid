{% comment %}
  The WEB feed's existing PP/NP scope is preserved. Full view follows TMB's
  line-card pattern across every layout.
{% endcomment %}
{% assign user_lang = trmnl.plugin_settings.custom_fields_values.userLanguage | default: "english" | downcase %}
{% case user_lang %}
  {% when "spanish" %}
    {% assign lang_suffix = "Es" %}
    {% assign words = "Líneas con incidencias|aviso|avisos|línea afectada|líneas afectadas|Sin avisos de servicio|TMB no comunica incidencias en los avisos consultados.|Datos no disponibles|No se ha podido leer la información de TMB.|Grave|Atención|Información|Mantenimiento|Obras|Desde|Hasta|más|Aviso de servicio|Red de metro|Próximamente|Fechas no disponibles|Más detalles en TMB|VIGENTE" | split: "|" %}
  {% when "catalan" %}
    {% assign lang_suffix = "Ca" %}
    {% assign words = "Línies amb incidències|avís|avisos|línia afectada|línies afectades|Sense avisos de servei|TMB no comunica incidències en els avisos consultats.|Dades no disponibles|No s’ha pogut llegir la informació de TMB.|Greu|Atenció|Informació|Manteniment|Obres|Des de|Fins a|més|Avís de servei|Xarxa de metro|Properament|Dates no disponibles|Més detalls a TMB|VIGENT" | split: "|" %}
  {% else %}
    {% assign lang_suffix = "En" %}
    {% assign words = "Lines with service notices|notice|notices|affected line|affected lines|No service notices|TMB reports no incidents in the notices checked.|Data unavailable|Could not read the service information from TMB.|Severe|Warning|Information|Maintenance|Works|From|Until|more|Service notice|Metro network|Upcoming|Dates unavailable|More details on TMB|CURRENT" | split: "|" %}
{% endcase %}
{% assign data_available = false %}
{% assign alerts_json_start = data.alerts | json | slice: 0, 1 %}
{% if alerts_json_start == '[' %}
  {% assign data_available = true %}
{% endif %}
{% assign sorted_alerts = '' | split: ',' %}
{% if data_available %}{% assign sorted_alerts = data.alerts | sort: 'tstamp' | reverse %}{% endif %}
{% assign severe_indices = "" %}
{% assign warning_indices = "" %}
{% assign other_indices = "" %}
{% assign affected_ids = "|" %}
{% assign affected_count = 0 %}
{% assign notice_count = 0 %}
{% for alert in sorted_alerts %}
  {% assign effect_code = alert.categories.effect_code | default: alert.effect.code | upcase %}
  {% assign effect_prefix = effect_code | slice: 0, 2 %}
  {% if effect_prefix == 'PP' or effect_prefix == 'NP' %}
    {% assign notice_count = notice_count | plus: 1 %}
    {% assign status = alert.categories.effect_status | upcase %}
    {% case status %}
      {% when 'SEVERE' %}
        {% assign severe_indices = severe_indices | append: forloop.index0 | append: ',' %}
      {% when 'WARNING' %}
        {% assign warning_indices = warning_indices | append: forloop.index0 | append: ',' %}
      {% else %}
        {% assign other_indices = other_indices | append: forloop.index0 | append: ',' %}
    {% endcase %}
    {% for entity in alert.entities %}
      {% assign line_id = entity.line_name | strip %}
      {% assign line_code = entity.line_code | append: '' %}
      {% if line_id == blank and line_code == '99' %}{% assign line_id = 'FM' %}{% endif %}
      {% if line_id != blank %}
        {% assign token = line_id | prepend: '|' | append: '|' %}
        {% unless affected_ids contains token %}
          {% assign affected_ids = affected_ids | append: line_id | append: '|' %}
          {% assign affected_count = affected_count | plus: 1 %}
        {% endunless %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}
{% assign ordered_indices = severe_indices | append: warning_indices | append: other_indices | split: ',' %}
{% assign affected_line_ids = affected_ids | split: '|' %}
{% assign lines_data = "L1;Hospital de Bellvitge / Fondo|L2;Paral·lel / Badalona Pompeu Fabra|L3;Zona Universitària / Trinitat Nova|L4;La Pau / Trinitat Nova|L5;Cornellà Centre / Vall d’Hebron|L9N;La Sagrera / Can Zam|L9S;Aeroport T1 / Zona Universitària|L10N;La Sagrera / Gorg|L10S;ZAL | Riu Vell / Collblanc|L11;Trinitat Nova / Can Cuiàs|FM;Paral·lel / Parc de Montjuïc" | split: '|' %}
{% assign ordered_affected_ids = '|' %}
{% for line_string in lines_data %}
  {% assign line_parts = line_string | split: ';' %}
  {% assign token = line_parts[0] | prepend: '|' | append: '|' %}
  {% if affected_ids contains token %}{% assign ordered_affected_ids = ordered_affected_ids | append: line_parts[0] | append: '|' %}{% endif %}
{% endfor %}
{% for line_id in affected_line_ids %}
  {% assign token = line_id | prepend: '|' | append: '|' %}
  {% unless line_id == blank or ordered_affected_ids contains token %}{% assign ordered_affected_ids = ordered_affected_ids | append: line_id | append: '|' %}{% endunless %}
{% endfor %}
{% assign affected_line_ids = ordered_affected_ids | split: '|' %}
{% assign priority_affected_ids = '|' %}
{% for index_string in ordered_indices %}
  {% assign alert_index = index_string | plus: 0 %}
  {% assign alert = sorted_alerts[alert_index] %}
  {% for entity in alert.entities %}
    {% assign line_id = entity.line_name | strip %}
    {% assign line_code = entity.line_code | append: '' %}
    {% if line_id == blank and line_code == '99' %}{% assign line_id = 'FM' %}{% endif %}
    {% assign token = line_id | prepend: '|' | append: '|' %}
    {% unless line_id == blank or priority_affected_ids contains token %}
      {% assign priority_affected_ids = priority_affected_ids | append: line_id | append: '|' %}
    {% endunless %}
  {% endfor %}
{% endfor %}
{% assign priority_affected_line_ids = priority_affected_ids | split: '|' %}
{%- capture svg_logo -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="-0.00071907 -0.0010941 93.88 70.99" width="256" height="256">
