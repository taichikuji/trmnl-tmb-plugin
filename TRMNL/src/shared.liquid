{%- endcapture -%}

<style>
  /* Scoped to this recipe: safe when two instances share a mashup. */
  .tmb-board { --tmb-gap: 10px; gap: var(--tmb-gap); }
  .tmb-board .tmb-heading { width: 100%; display: flex; align-items: baseline; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .tmb-board .tmb-heading .title { min-width: 0; font-weight: bold; }
  .tmb-board .tmb-summary { width: 100%; text-align: left; }
  .tmb-board .tmb-card-grid { width: 100%; min-height: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 12px; }
  .tmb-board .tmb-content { min-width: 0; }
  .tmb-board .tmb-tabs { width: 100%; display: flex; align-items: center; gap: 12px; }
  .tmb-board .tmb-tab { font-weight: bold; padding-bottom: 3px; border-bottom: 3px solid currentColor; }
  .tmb-board .tmb-line-card { position: relative; gap: 10px; min-height: 64px; padding: 9px 10px 9px 14px; border: 1px solid currentColor; overflow: hidden; }
  .tmb-board .tmb-line-rail { position: absolute; inset: 0 auto 0 0; width: 5px; }
  .tmb-board .tmb-line-meta { align-self: center; }
  .tmb-board .tmb-line-badge { min-width: 38px; padding: 7px 5px; text-align: center; font-weight: bold; }
  .tmb-board .tmb-line-route { display: block; margin-bottom: 5px; font-weight: bold; }
  .tmb-board .tmb-line-status { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 9px; }
  .tmb-board .tmb-alert-symbol { font-weight: bold; }
  .tmb-board .tmb-source { width: 100%; display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: auto; text-align: right; }
  .tmb-board .tmb-source .qr-code { display: block; box-sizing: content-box; width: 99px; height: 99px; padding: 8px; background: white; }
  .tmb-board .tmb-state { margin: auto; width: 100%; text-align: center; }
  .tmb-board .tmb-state-symbol { margin: 0 auto 12px; width: 48px; height: 48px; border: 2px solid currentColor; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 30px; font-weight: bold; }
  .tmb-board .tmb-state .description { margin: 8px auto 0; max-width: 32em; }
  .tmb-board--quadrant .tmb-more { margin-top: auto; }
  .tmb-board--half_horizontal, .tmb-board--half_vertical, .tmb-board--quadrant { --tmb-gap: 6px; }
  .tmb-board--half_vertical .tmb-card-grid, .tmb-board--quadrant .tmb-card-grid { grid-template-columns: 1fr; }
  .tmb-board--half_horizontal .tmb-card-grid, .tmb-board--half_vertical .tmb-card-grid, .tmb-board--quadrant .tmb-card-grid { gap: 5px 8px; }
  .tmb-board--half_horizontal .tmb-line-card, .tmb-board--half_vertical .tmb-line-card, .tmb-board--quadrant .tmb-line-card { min-height: 46px; padding: 5px 7px 5px 11px; gap: 7px; }
  .tmb-board--half_horizontal .tmb-line-badge, .tmb-board--half_vertical .tmb-line-badge, .tmb-board--quadrant .tmb-line-badge { min-width: 32px; padding: 4px; }
  .tmb-board--half_horizontal .tmb-line-route, .tmb-board--half_vertical .tmb-line-route, .tmb-board--quadrant .tmb-line-route { margin-bottom: 1px; }
  .tmb-board--quadrant .tmb-line-cause { display: none; }
  .screen--lg .tmb-board { --tmb-gap: 16px; }
  .screen--lg .tmb-board .tmb-line-card { min-height: 92px; padding: 14px 16px 14px 22px; gap: 16px; }
  .screen--lg .tmb-board .tmb-line-rail { width: 7px; }
  .screen--lg .tmb-board .tmb-line-badge { min-width: 52px; padding: 10px 7px; }
  .screen--lg .tmb-board .tmb-source .qr-code { width: 144px; height: 144px; padding: 12px; }
  .tmb-board--dense { --tmb-gap: 6px; }
  .tmb-board--dense .tmb-card-grid { gap: 5px 10px; }
  .tmb-board--dense .tmb-line-card { min-height: 42px; padding: 4px 8px 4px 12px; }
  .tmb-board--dense .tmb-line-badge { min-width: 34px; padding: 4px; }
  .tmb-board--dense .tmb-line-route { margin-bottom: 1px; }
  .tmb-board--dense .tmb-source .qr-code { width: 60px; height: 60px; padding: 5px; }
  .screen--lg .tmb-board--dense .tmb-line-card { min-height: 64px; padding: 8px 12px 8px 18px; }
  .screen--lg .tmb-board--dense .tmb-source .qr-code { width: 96px; height: 96px; padding: 8px; }
  .screen--lg .tmb-board--half_horizontal .tmb-line-card, .screen--lg .tmb-board--half_vertical .tmb-line-card, .screen--lg .tmb-board--quadrant .tmb-line-card { min-height: 64px; padding: 8px 10px 8px 16px; gap: 10px; }
  .screen--1bit:not([class*="screen--color-"]) .tmb-line-badge,
  .screen--2bit:not([class*="screen--color-"]) .tmb-line-badge,
  .screen--4bit:not([class*="screen--color-"]) .tmb-line-badge { color: var(--white) !important; -webkit-text-fill-color: var(--white) !important; background: var(--black) !important; }
  .screen--1bit:not([class*="screen--color-"]) .tmb-tab,
  .screen--2bit:not([class*="screen--color-"]) .tmb-tab,
  .screen--4bit:not([class*="screen--color-"]) .tmb-tab { color: var(--black) !important; -webkit-text-fill-color: var(--black) !important; }
  .screen--color-4bwry .tmb-line-badge.bg--green { color: var(--black) !important; -webkit-text-fill-color: var(--black) !important; }
  .screen--lg .tmb-board .tmb-state-symbol { width: 72px; height: 72px; font-size: 44px; }
  /* Keep short mashup slots useful even in portrait. */
  .tmb-board--half_horizontal .tmb-heading, .tmb-board--quadrant .tmb-heading { flex-wrap: nowrap; }
</style>

{% template line_card %}
  {% assign route = words[18] %}
  {% for line_string in lines_data %}
    {% assign line_parts = line_string | split: ';' %}
    {% if line_parts[0] == line_id %}{% assign route = line_parts[1] %}{% break %}{% endif %}
  {% endfor %}
  {% assign line_notice_count = 0 %}
  {% assign line_status = '' %}
  {% assign line_cause = '' %}
  {% for index_string in ordered_indices %}
    {% assign alert_index = index_string | plus: 0 %}
    {% assign alert = sorted_alerts[alert_index] %}
    {% assign belongs_to_line = false %}
    {% for entity in alert.entities %}
      {% assign entity_line_id = entity.line_name | strip %}
      {% assign entity_line_code = entity.line_code | append: '' %}
      {% if entity_line_id == blank and entity_line_code == '99' %}{% assign entity_line_id = 'FM' %}{% endif %}
      {% if entity_line_id == line_id %}{% assign belongs_to_line = true %}{% break %}{% endif %}
    {% endfor %}
    {% if belongs_to_line %}
      {% assign line_notice_count = line_notice_count | plus: 1 %}
      {% assign alert_status = alert.categories.effect_status | upcase %}
      {% if alert_status == 'SEVERE' or line_status == blank %}{% assign line_status = alert_status %}{% endif %}
      {% if line_cause == blank %}{% assign line_cause = alert.categories.cause_code | upcase %}{% endif %}
    {% endif %}
  {% endfor %}
  {% assign line_color = 'bg--black' %}
  {% assign line_text = 'text--white' %}
  {% case line_id %}
    {% when 'L1' %}{% assign line_color = 'bg--red' %}
    {% when 'L2' %}{% assign line_color = 'bg--purple' %}
    {% when 'L3', 'L11' %}{% assign line_color = 'bg--green' %}
    {% when 'L4' %}{% assign line_color = 'bg--yellow' %}{% assign line_text = 'text--black' %}
    {% when 'L5' %}{% assign line_color = 'bg--blue' %}
    {% when 'L9N', 'L9S' %}{% assign line_color = 'bg--orange' %}
    {% when 'L10N', 'L10S' %}{% assign line_color = 'bg--cyan' %}{% assign line_text = 'text--black' %}
  {% endcase %}
  {% assign line_status_label = line_status | default: words[11] %}
  {% case line_status %}{% when 'SEVERE' %}{% assign line_status_label = words[9] %}{% when 'WARNING' %}{% assign line_status_label = words[10] %}{% when 'INFO', 'INFORMATION' %}{% assign line_status_label = words[11] %}{% endcase %}
  {% assign line_cause_label = line_cause %}
  {% case line_cause %}{% when 'MAINTENANCE' %}{% assign line_cause_label = words[12] %}{% when 'CONSTRUCTION' %}{% assign line_cause_label = words[13] %}{% endcase %}
  <div class="item tmb-line-card" data-line-id="{{ line_id | escape }}">
    <span class="tmb-line-rail {{ line_color }}"></span>
    <div class="tmb-line-meta"><span class="label lg:label--large tmb-line-badge {{ line_color }} {{ line_text }}">{{ line_id | escape }}</span></div>
    <div class="content tmb-content">
      <span class="title title--small lg:title--base tmb-line-route" data-clamp="1">{{ route | escape }}</span>
      <div class="tmb-line-status">
        <span class="label label--small lg:label--base"><span class="tmb-alert-symbol {% if line_status == 'SEVERE' %}text--red{% else %}text--orange{% endif %}">△</span> {{ line_status_label | escape }}</span>
        <span class="label label--small lg:label--base">{{ line_notice_count }} {% if line_notice_count == 1 %}{{ words[1] }}{% else %}{{ words[2] }}{% endif %}</span>
        {% if line_cause_label != blank %}<span class="label label--small lg:label--base tmb-line-cause">{{ line_cause_label | escape }}</span>{% endif %}
      </div>
    </div>
  </div>
{% endtemplate %}
